# Optional configuration; no credentials are included.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
API_BASE_URL=
API_KEY=
API_MODEL=
# Leave empty to use packaged prompts and the default forecaster location.
PROMPTS_DIR=
PRICE_FORECASTER_ROOT=
PRICE_CACHE_DIR=./data/price_cache
PRICE_CACHE_TTL_MIN=120
# Optional absolute path to an existing CBC executable (never downloaded automatically).
CBC_PATH=
